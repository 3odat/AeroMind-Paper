\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces CCR and ASR across all 15 attack scenarios. Six scenarios (S02, S03, S04, S11, S13, S14) achieve zero ASR despite non-zero CCR, reflecting low retrieval ranking, LLM-level implicit robustness, and failed authority spoofing. Eight scenarios achieve 100\% ASR; S05 achieves 80\%.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:asr_ccr_bar}{{4}{12}{CCR and ASR across all 15 attack scenarios. Six scenarios (S02, S03, S04, S11, S13, S14) achieve zero ASR despite non-zero CCR, reflecting low retrieval ranking, LLM-level implicit robustness, and failed authority spoofing. Eight scenarios achieve 100\% ASR; S05 achieves 80\%}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Physical deviation from the legitimate target (mean across all agent-flights, $n{=}5$ seeds). Under the S01 attack, the drone deviates 30.71m from the legitimate waypoint. The defense pipeline (D1+D2+D3) prevents trap-flight (0\% ASR) but introduces residual deviation (10.08m), driven by Agent~2 context asymmetry (see Section~\ref {sec:defense}).}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:deviation}{{5}{12}{Physical deviation from the legitimate target (mean across all agent-flights, $n{=}5$ seeds). Under the S01 attack, the drone deviates 30.71m from the legitimate waypoint. The defense pipeline (D1+D2+D3) prevents trap-flight (0\% ASR) but introduces residual deviation (10.08m), driven by Agent~2 context asymmetry (see Section~\ref {sec:defense})}{figure.5}{}}
