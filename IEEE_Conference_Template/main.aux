\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Trust boundaries in \textit  {AeroMind}. Eight boundaries (TB1--TB8) delineate trust zones across the data pipeline: Ingestion~$\to $~Shared Memory Store~$\to $~Retrieval Engine~$\to $~LLM Reasoning~$\to $~Safety Validator~$\to $~MAVSDK/Drones, with environment feedback re-entering at TB8. TB5 (Retrieval~$\to $~LLM, shown in bold) is the critical boundary: poisoned entries cross it unconditionally and become trusted facts inside the LLM. Attacker profiles A1, A3, and A4 inject at distinct pipeline stages; the orange write-back arrow shows the contagion path through which poison propagates across agents. The dashed Defense Pipeline (Section~\ref {sec:defense}) is an optional interposition point between retrieval and reasoning.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:trust_boundaries}{{2}{7}{Trust boundaries in \textit {AeroMind}. Eight boundaries (TB1--TB8) delineate trust zones across the data pipeline: Ingestion~$\to $~Shared Memory Store~$\to $~Retrieval Engine~$\to $~LLM Reasoning~$\to $~Safety Validator~$\to $~MAVSDK/Drones, with environment feedback re-entering at TB8. TB5 (Retrieval~$\to $~LLM, shown in bold) is the critical boundary: poisoned entries cross it unconditionally and become trusted facts inside the LLM. Attacker profiles A1, A3, and A4 inject at distinct pipeline stages; the orange write-back arrow shows the contagion path through which poison propagates across agents. The dashed Defense Pipeline (Section~\ref {sec:defense}) is an optional interposition point between retrieval and reasoning}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-B}}GAP 2: Cross-Agent Propagation}{7}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Stigmergic Contagion Model (S06). At T=0, Scout~1 (compromised) injects six poisoned entries across episodic, coordination, and semantic layers. At T=1, Scout~2 and the Supervisor independently retrieve poisoned entries as trusted context (Scout~2: CCR~=~0.67; Supervisor: CCR~=~0.80). Result: CASR~=~1.00 --- the entire swarm is infected from a single injection point. Write-back amplification (S10) is a separate phenomenon evaluated in Section~\ref {sec:evaluation}.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:contagion}{{3}{7}{Stigmergic Contagion Model (S06). At T=0, Scout~1 (compromised) injects six poisoned entries across episodic, coordination, and semantic layers. At T=1, Scout~2 and the Supervisor independently retrieve poisoned entries as trusted context (Scout~2: CCR~=~0.67; Supervisor: CCR~=~0.80). Result: CASR~=~1.00 --- the entire swarm is infected from a single injection point. Write-back amplification (S10) is a separate phenomenon evaluated in Section~\ref {sec:evaluation}}{figure.3}{}}
